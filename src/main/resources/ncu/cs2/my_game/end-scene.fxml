<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ncu.cs2.my_game.controller.EndSceneController"
           style="-fx-background-color: #06080f;">

    <VBox alignment="CENTER" spacing="18">
        <padding>
            <Insets top="80" bottom="80" left="80" right="80"/>
        </padding>

        <!-- 裝飾標籤 -->
        <Label text="&lt; MISSION  COMPLETE &gt;"
               style="-fx-font-size: 13px; -fx-text-fill: #7a5c00; -fx-font-family: monospace;"/>

        <!-- 通關標題 -->
        <Label text="恭喜通關！"
               style="-fx-font-size: 60px; -fx-font-weight: bold; -fx-text-fill: #ffd700;"/>

        <!-- 通關時間（由 Controller 填入） -->
        <Label fx:id="timeLabel"
               text="通關時間：-- 秒"
               style="-fx-font-size: 22px; -fx-text-fill: #64b5f6; -fx-font-family: monospace;"/>

        <!-- 間距 -->
        <Label text="" prefHeight="28"/>

        <!-- 再玩一次按鈕 -->
        <Button text="[ 再玩一次 ]"
                onAction="#onPlayAgain"
                prefWidth="240" prefHeight="52"
                style="-fx-font-size: 18px; -fx-font-family: monospace; -fx-background-color: #081208; -fx-text-fill: #00e676; -fx-border-color: #00e676; -fx-border-width: 1.5; -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"/>

        <!-- 離開按鈕 -->
        <Button text="[ 離開 ]"
                onAction="#onExit"
                prefWidth="240" prefHeight="52"
                style="-fx-font-size: 18px; -fx-font-family: monospace; -fx-background-color: #08151f; -fx-text-fill: #2e5070; -fx-border-color: #1a3050; -fx-border-width: 1.5; -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"/>
    </VBox>

</StackPane>
